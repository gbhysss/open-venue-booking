# Copy this file to .env and replace every development placeholder before deployment.
DATABASE_URL=postgresql://openvenue:change-me-db-password@localhost:5432/openvenue
POSTGRES_PASSWORD=change-me-db-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_NAME=OpenVenue
APP_TIME_ZONE=Asia/Shanghai
BOOKING_MAX_PER_MINUTE=60
# Set to false in a production deployment after initialization.
ALLOW_DEMO_SEED=false
