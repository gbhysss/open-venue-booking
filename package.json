{
  "name": "open-venue-booking",
  "version": "0.2.2",
  "private": true,
  "description": "Self-hosted open source venue booking and approval system",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:static": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:api": "tsx --test tests/api-regression.test.ts",
    "test:docker": "bash scripts/test-docker.sh"
  },
  "dependencies": {
    "better-auth": "^1.4.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "type": "module"
}
